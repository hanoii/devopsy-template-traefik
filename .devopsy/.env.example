# Copy to .env and adjust.

# Required. Let's Encrypt account email.
TRAEFIK_CERTIFICATESRESOLVERS_LETSENCRYPT1_ACME_EMAIL=you@example.com
# Staging by default. Uncomment for real certificates.
#TRAEFIK_CERTIFICATESRESOLVERS_LETSENCRYPT1_ACME_CASERVER=https://acme-v02.api.letsencrypt.org/directory

# Required. Owner of mnt/letsencrypt: `id -u` and `id -g`.
DEVOPSY_UID=1000
DEVOPSY_GID=1000
# Group of the Docker socket: `stat -c %g /var/run/docker.sock`.
DEVOPSY_DOCKER_GID=999

# Optional.
# Default certificate resolver: letsencrypt1 (HTTP-01) or cloudflare (DNS-01,
# needs dns.env, see dns.env.example).
#DEVOPSY_CERTRESOLVER=letsencrypt1
#DEVOPSY_ENVIRONMENT=main
#DEVOPSY_HTTP_PORT=80
#DEVOPSY_HTTPS_PORT=443
#DEVOPSY_API_PORT=127.0.0.1:8080
#TRAEFIK_LOG_LEVEL=ERROR
