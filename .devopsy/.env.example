# Settings for this server's Traefik. On a server they live in
# traefik/main/shared/.env (under its release root): set them from your machine with
#   devopsy @<server>-traefik --vars set --show KEY   (not secrets)
#   devopsy @<server>-traefik --vars set KEY          (secrets, hidden prompt)
# Locally, copy this file to .env.

# Required. Let's Encrypt account email, for every resolver.
TRAEFIK_CERTIFICATESRESOLVERS_LETSENCRYPT1_ACME_EMAIL=you@example.com
# Staging by default. `devopsy letsencrypt production` switches every
# resolver to real certificates.
#TRAEFIK_CERTIFICATESRESOLVERS_LETSENCRYPT1_ACME_CASERVER=https://acme-v02.api.letsencrypt.org/directory

# Default certificate resolver: letsencrypt1 (HTTP-01), acmedns or cloudflare
# (DNS-01). See README.md.
#DEVOPSY_CERTRESOLVER=letsencrypt1

# Wildcard URLs, <project>-<environment>.<domain>: one wildcard certificate for all of them,
# written by `devopsy deploy`. Exported to projects (devopsy.export label):
# a project importing proxy/WILDCARD_DOMAIN gets <project>-<environment>.<domain> unless
# its target sets otherwise. Until October 2026: DEVOPSY_WILDCARD_DOMAIN,
# which deploy renames.
# The resolver: auto (acmedns, else cloudflare, else none), acmedns,
# cloudflare or none (each wildcard URL gets its own HTTP-01 certificate).
#DEVOPSY_PROXY_WILDCARD_DOMAIN=vm1.example.com
#DEVOPSY_WILDCARD_CERTRESOLVER=auto

# This server's public IPv4, for `devopsy domains`. Unset: as 1.1.1.1 sees
# the server, which also works behind NAT.
#DEVOPSY_PUBLIC_IP=203.0.113.10

# Optional acme-dns server for the acmedns resolver. See README.md.
#COMPOSE_PROFILES=acmedns
#DEVOPSY_ACMEDNS_DOMAIN=acme-vm1.example.com
# Public IPv4 acme-dns listens on, also in `devopsy acmedns` output.
# `devopsy deploy` detects and saves it when unset.
#DEVOPSY_ACMEDNS_IP=203.0.113.10

# Optional cloudflare resolver: a Cloudflare API token. See README.md.
#DEVOPSY_CLOUDFLARE_DNS_API_TOKEN=
# Where the cloudflare resolver checks its TXT record before asking Let's
# Encrypt: resolvers tried in order (127.0.0.11 is the host's, through
# Docker), then the zone's authoritative nameservers on port 53. Where
# outbound DNS is blocked, skip the checks and wait instead: the host's
# resolver caches "no record" from the lookup made before writing it.
#DEVOPSY_DNS_RESOLVERS=127.0.0.11:53,1.1.1.1:53,1.0.0.1:53
#DEVOPSY_DNS_SKIP_CHECKS=true
#DEVOPSY_DNS_PROPAGATION_DELAY=60s

# Group of the Docker socket (`stat -c %g /var/run/docker.sock`).
# `devopsy deploy` detects and saves it when unset.
#DEVOPSY_DOCKER_GID=999

# Longest time a request may take to arrive, body included. Raise it for
# large uploads, like a registry's image layers (0: no limit).
#DEVOPSY_READ_TIMEOUT=60s
#TRAEFIK_LOG_LEVEL=ERROR

# Other ports, for tests on a machine already using these.
#DEVOPSY_HTTP_PORT=80
#DEVOPSY_HTTPS_PORT=443
#DEVOPSY_API_PORT=127.0.0.1:8080
#DEVOPSY_ACMEDNS_PORT=53
