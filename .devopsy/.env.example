# Settings for this server's Traefik. On a server they live in
# traefik/prod/shared/.env (under its release root): set them from your machine with
#   devopsy @<server>-traefik --vars set --show KEY   (not secrets)
#   devopsy @<server>-traefik --vars set KEY          (secrets, hidden prompt)
# Locally, copy this file to .env.

# Required. Let's Encrypt account email, for every resolver.
PROXY_LE_ACME_EMAIL=you@example.com
# Staging by default. `devopsy letsencrypt production` switches every
# resolver to real certificates.
#PROXY_LE_ACME_CASERVER=https://acme-v02.api.letsencrypt.org/directory

# Default certificate resolver, for every router that names none:
# le-http01 (HTTP-01), le-dns01-selfhosted (acme-dns) or le-dns01-cloudflare
# (DNS-01). See README.md.
#PROXY_CERTRESOLVER=le-http01

# Wildcard URLs, <project>-<environment>.<domain>: one wildcard certificate for all of them,
# written by `devopsy deploy`. Exported to projects (devopsy.export label):
# a project importing proxy/BASE_DOMAIN gets <project>-<environment>.<domain> unless
# its target sets otherwise.
# The resolver: auto (le-dns01-selfhosted when acme-dns is set up, else
# le-dns01-cloudflare with a token, else none), le-dns01-selfhosted,
# le-dns01-cloudflare or none (each wildcard URL gets its own HTTP-01
# certificate).
#PROXY_BASE_DOMAIN=vm1.example.com
#PROXY_WILDCARD_CERTRESOLVER=auto

# This server's public IPv4, for `devopsy domains`. Unset: as 1.1.1.1 sees
# the server, which also works behind NAT.
#PROXY_PUBLIC_IP=203.0.113.10

# Optional acme-dns server for the le-dns01-selfhosted resolver. See README.md.
#COMPOSE_PROFILES=acmedns
#PROXY_ACMEDNS_DOMAIN=acme-vm1.example.com
# Public IPv4 acme-dns listens on, also in `devopsy acmedns` output.
# `devopsy deploy` detects and saves it when unset.
#PROXY_ACMEDNS_IP=203.0.113.10

# Optional le-dns01-cloudflare resolver: a Cloudflare API token. See README.md.
#PROXY_CLOUDFLARE_DNS_API_TOKEN=
# Where le-dns01-cloudflare checks its TXT record before asking Let's
# Encrypt: resolvers tried in order (127.0.0.11 is the host's, through
# Docker), then the zone's authoritative nameservers on port 53. Where
# outbound DNS is blocked, skip the checks and wait instead: the host's
# resolver caches "no record" from the lookup made before writing it.
#PROXY_DNS_RESOLVERS=127.0.0.11:53,1.1.1.1:53,1.0.0.1:53
#PROXY_DNS_SKIP_CHECKS=true
#PROXY_DNS_PROPAGATION_DELAY=60s

# Group of the Docker socket (`stat -c %g /var/run/docker.sock`).
# `devopsy deploy` detects and saves it when unset.
#PROXY_DOCKER_GID=999

# Longest time a request may take to arrive, body included. Raise it for
# large uploads, like a registry's image layers (0: no limit).
#PROXY_READ_TIMEOUT=60s
#TRAEFIK_LOG_LEVEL=ERROR

# Other ports, for tests on a machine already using these.
#PROXY_HTTP_PORT=80
#PROXY_HTTPS_PORT=443
#PROXY_API_PORT=127.0.0.1:8080
#PROXY_ACMEDNS_PORT=53
