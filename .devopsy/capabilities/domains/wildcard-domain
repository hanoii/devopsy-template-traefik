#!/bin/sh
# devopsy's `domains` capability, `wildcard-domain` action (see devopsy-cli's
# README): the server's wildcard domain, DEVOPSY_WILDCARD_DOMAIN, or "" when
# it has none. devopsy asks at each release, so every environment gets
# <project>.<domain> unless its target sets DEVOPSY_WILDCARD_DOMAIN itself.
set -eu
domain=${DEVOPSY_WILDCARD_DOMAIN:-}
case $domain in
  *[!a-z0-9.-]*)
    echo "wildcard-domain: DEVOPSY_WILDCARD_DOMAIN is not a domain name: $domain" >&2
    exit 1
    ;;
esac
printf '{"version": 1, "wildcard_domain": "%s"}\n' "$domain"
