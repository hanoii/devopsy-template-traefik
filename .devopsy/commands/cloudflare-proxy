#!/bin/sh
# Real client IPs for sites behind Cloudflare's proxy, through the local
# plugin in plugins-local/: requests from Cloudflare's ranges get the visitor's
# CF-Connecting-IP as their client IP; others lose that header.
#
#   devopsy cloudflare-proxy on        fetch the ranges, enable it (restarts Traefik)
#   devopsy cloudflare-proxy refresh   fetch the ranges again (no restart)
#   devopsy cloudflare-proxy off       disable it (restarts Traefik)
#   devopsy cloudflare-proxy           show whether it is on
#
# DEVOPSY_CLOUDFLARE_EXTRA_RANGES (in .env, space separated) adds ranges, for
# testing or another proxy in front.
set -eu

env_file=$DEVOPSY_PROJECT_DIR/cloudflare-proxy.env
dynamic=$DEVOPSY_PROJECT_DIR/mnt/dynamic/cloudflare-real-ip.yaml

ranges() {
  list=$(curl -fsS --max-time 15 https://www.cloudflare.com/ips-v4) || {
    echo "cloudflare-proxy: could not fetch https://www.cloudflare.com/ips-v4" >&2
    return 1
  }
  for r in $list ${DEVOPSY_CLOUDFLARE_EXTRA_RANGES:-}; do
    case $r in
      *[!0-9./]* | '') echo "cloudflare-proxy: unexpected range '$r'" >&2; return 1 ;;
      */*) echo "$r" ;;
      *) echo "cloudflare-proxy: unexpected range '$r'" >&2; return 1 ;;
    esac
  done
}

# Writes the middleware, only touching the file when the ranges changed.
write_dynamic() {
  r=$(ranges) || exit 1
  [ "$(printf '%s\n' "$r" | grep -c /)" -ge 10 ] || { echo "cloudflare-proxy: too few ranges, not writing" >&2; exit 1; }
  tmp=$dynamic.tmp
  {
    echo "# Written by 'devopsy cloudflare-proxy'. Refresh with 'devopsy cloudflare-proxy refresh'."
    echo "http:"
    echo "  middlewares:"
    echo "    cloudflare-real-ip:"
    echo "      plugin:"
    echo "        cloudflare:"
    echo "          trustedIPs:"
    printf '%s\n' "$r" | sed 's/^/            - /'
  } >"$tmp"
  if [ -f "$dynamic" ] && cmp -s "$tmp" "$dynamic"; then
    rm -f "$tmp"
    echo "Cloudflare ranges unchanged."
  else
    mv "$tmp" "$dynamic"
    echo "Wrote $(printf '%s\n' "$r" | grep -c /) ranges to mnt/dynamic/cloudflare-real-ip.yaml."
  fi
}

case "${1:-}" in
  on)
    write_dynamic
    cat >"$env_file" <<EOT
# Written by 'devopsy cloudflare-proxy on'. Remove with 'devopsy cloudflare-proxy off'.
TRAEFIK_EXPERIMENTAL_LOCALPLUGINS_CLOUDFLARE_MODULENAME=github.com/hanoii/devopsy-traefik/cloudflare
TRAEFIK_ENTRYPOINTS_WEBSECURE_HTTP_MIDDLEWARES=cloudflare-real-ip@file
EOT
    devopsy up -d --wait
    echo "Cloudflare real client IPs: on."
    ;;
  refresh)
    [ -f "$env_file" ] || { echo "cloudflare-proxy: off, nothing to refresh" >&2; exit 0; }
    write_dynamic
    ;;
  off)
    rm -f "$env_file"
    devopsy up -d --wait
    rm -f "$dynamic"
    echo "Cloudflare real client IPs: off."
    ;;
  '')
    if [ -f "$env_file" ]; then echo "Cloudflare real client IPs: on."; else echo "Cloudflare real client IPs: off."; fi
    ;;
  *)
    echo "Usage: devopsy cloudflare-proxy [on|off|refresh]" >&2
    exit 1
    ;;
esac
