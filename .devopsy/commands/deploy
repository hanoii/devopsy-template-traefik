#!/bin/sh
## Description: Start or update Traefik with this release's settings (what release and rollback run)
# Prepares the host side, then starts or updates every service:
#
# - Host-written directories in mnt/, owned by the deploy user. devopsy
#   creates mnt/letsencrypt and mnt/acmedns and gives them to 10001
#   (devopsy.mnt.owner) before this runs.
# - Values detected once and kept in .env, so a plain `devopsy up` works
#   later: the Docker socket's group, and acme-dns's public IP.
# - The public wildcard certificate (PROXY_BASE_DOMAIN), or none.
# - Static settings: the entrypoint's middlewares (static_env), and trusted
#   proxies' ranges, fetched again (`devopsy proxies refresh`).
# - Domains queued by `devopsy forget` leave Traefik's stores (forget_apply).
# - Then, with Traefik running, middlewares turned off are removed, and who
#   may reach its API is updated (api_access).
set -eu
. "$DEVOPSY_PROJECT_DIR/lib/common.sh"

# A release checks them before its switch (commands/check, its prepare
# step); a plain deploy here.
check_settings

mkdir -p "$dir/mnt/dynamic" "$dir/mnt/proxies"

# GNU stat: on macOS the socket is root's and the default of 0 works.
if [ -z "${PROXY_DOCKER_GID:-}" ] && gid=$(stat -c %g /var/run/docker.sock 2>/dev/null); then
  env_set PROXY_DOCKER_GID "$gid"
  echo "deploy: PROXY_DOCKER_GID=$gid in .env"
fi

# acme-dns binds the public IP only: 0.0.0.0:53 clashes with
# systemd-resolved's 127.0.0.53:53 on many cloud images.
case ",${COMPOSE_PROFILES:-}," in
  *,acmedns,*)
    if [ -z "${PROXY_ACMEDNS_IP:-}" ] && ip=$(detect_ip) && [ -n "$ip" ]; then
      env_set PROXY_ACMEDNS_IP "$ip"
      echo "deploy: PROXY_ACMEDNS_IP=$ip in .env"
    fi
    ;;
  *)
    # Turned off: `up` leaves a service whose profile is off running.
    # Named, compose finds it anyway.
    quiet rm -s -f acmedns >/dev/null
    ;;
esac

# One wildcard certificate for every project's wildcard URL. It needs a
# DNS-01 resolver: auto picks le-dns01-selfhosted (acme-dns), else
# le-dns01-cloudflare, else none (each wildcard URL then gets its own
# HTTP-01 certificate). The router only exists to request the certificate:
# its rule matches one reserved name, so other hosts keep Traefik's usual
# 404.
wildcard=$dir/mnt/dynamic/public-wildcard.yaml
domain=${PROXY_BASE_DOMAIN:-}
resolver=${PROXY_WILDCARD_CERTRESOLVER:-auto}
if [ "$resolver" = auto ]; then
  if [ -n "${PROXY_ACMEDNS_DOMAIN:-}" ]; then
    resolver=le-dns01-selfhosted
  elif [ -n "${PROXY_CLOUDFLARE_DNS_API_TOKEN:-}" ]; then
    resolver=le-dns01-cloudflare
  else
    resolver=none
  fi
fi
if [ -z "$domain" ] || [ "$resolver" = none ]; then
  if [ -f "$wildcard" ]; then
    rm -f "$wildcard"
    echo "deploy: no public wildcard certificate"
  fi
elif write_if_changed "$wildcard" "# Written by 'devopsy deploy' from PROXY_BASE_DOMAIN.
http:
  routers:
    devopsy-public-wildcard:
      rule: 'Host(\`devopsy-wildcard.$domain\`)'
      entryPoints: [websecure]
      service: noop@internal
      tls:
        certResolver: $resolver
        domains:
          - main: '*.$domain'
"; then
  echo "deploy: public wildcard *.$domain through $resolver"
fi

# The entrypoint's middlewares; `up` below restarts Traefik when the static
# settings change.
static_env --no-restart

# Ranges from URLs can change. A failed fetch keeps the current ones.
if [ -s "$dir/mnt/proxies/proxies.conf" ]; then
  devopsy proxies refresh || warn "could not refresh the trusted proxies' ranges, keeping the current ones"
fi

# Domains queued by `devopsy forget`: Traefik stops for them, `up` starts it.
forget_apply

devopsy up -d --wait --remove-orphans "$@"
static_env
api_access
