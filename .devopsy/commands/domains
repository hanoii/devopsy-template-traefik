#!/bin/sh
## Description: DNS, certificate and next step per host this Traefik routes (domains [<compose project>] [--retry])
# devopsy @<server>-traefik domains [<compose project>] [--retry]
#
# For a compose project (like whoami-prod), the hosts its running containers'
# Traefik rules name; without one, every host Traefik routes and its
# wildcards. Per host: what Traefik knows (routed, resolver, how the
# certificate is issued, the acme-dns CNAME), then, from this server, DNS
# through 1.1.1.1, the certificate it presents for the name, and a request
# through what DNS returns (Cloudflare's proxy recognized). A host routed
# only through a Cloudflare Tunnel has no port here: only DNS and the
# request through Cloudflare, and the tunnel's connectors are listed. Ends
# each host with what to do next, and with the devopsy --probe line to
# check the others from your machine.
#
#   --retry  ask Traefik for missing certificates again (lib/retry), then
#            check again. The request is withdrawn once every certificate
#            exists.
set -eu
# Hosts like *.example.org are words, never file patterns.
set -f
. "$DEVOPSY_PROJECT_DIR/lib/common.sh"

project=
retry=0
for a in "$@"; do
  case $a in
    --retry) retry=1 ;;
    -h | --help)
      sed -n '3,18p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    -*) die "usage: domains [<compose project>] [--retry]" ;;
    *)
      [ -z "$project" ] || die "usage: domains [<compose project>] [--retry]"
      project=$a
      ;;
  esac
done

name=${project:-server}
case $name in *[!a-z0-9_-]*) die "not a compose project name: $name" ;; esac
if [ -n "$project" ] && [ -z "$(docker ps -q --filter "label=com.docker.compose.project=$project")" ]; then
  die "no running containers of compose project $project"
fi

# The server's public IPv4: PROXY_PUBLIC_IP, else as 1.1.1.1 sees it (in
# the check script, right behind NAT too), else acme-dns's, else the default
# route's.
fallback_ip=${PROXY_ACMEDNS_IP:-$(detect_ip)}

# The hosts a compose project's running containers route, from their Traefik
# rules as compose interpolated them.
project_hosts() {
  ids=$(docker ps -q --filter "label=com.docker.compose.project=$1")
  # shellcheck disable=SC2086,SC2016
  docker inspect --format '{{json .Config.Labels}}' $ids | jq -rs '
    [.[] | to_entries[] | select(.key | test("^traefik\\.http\\.routers\\.[^.]+\\.rule$")) | .value
     | scan("Host\\(`([^`]+)`\\)") | .[0] | ascii_downcase] | unique[]'
}

# Network checks from this server, in the curl service: the server's IP on
# the first line, then one tab-separated line per name (jq turns them into
# JSON). DNS over HTTPS from 1.1.1.1, the certificate this server presents
# (issuer and expiry from an unverified handshake's verbose output, valid
# from a verified one's), and a request through what DNS returns. Names
# in $TUNNELED have no port here: no handshake with this server, and the
# request's Cloudflare error code (1033) from its body.
# shellcheck disable=SC2016
check_script='
if [ -z "$IP" ]; then
  IP=$(curl -s --max-time 10 https://1.1.1.1/cdn-cgi/trace | sed -n "s/^ip=\([0-9.]*\)$/\1/p")
fi
IP=${IP:-$FALLBACK_IP}
printf "%s\n" "$IP"
doh() { curl -s --max-time 10 -H "accept: application/dns-json" "https://1.1.1.1/dns-query?name=$1&type=$2" || echo null; }
for name; do
  base=${name#devopsy-wildcard.}
  a=$(doh "$name" A)
  case $a in "{"*) a=$(printf "%s" "$a" | tr -d "\t\n\r") ;; *) a=null ;; esac
  challenge=$(doh "_acme-challenge.$base" CNAME)
  case $challenge in "{"*) challenge=$(printf "%s" "$challenge" | tr -d "\t\n\r") ;; *) challenge=null ;; esac
  issuer= expire= valid=false cferror=
  case " $TUNNELED " in
    *" $name "*)
      # Headers, then the start of the body: Cloudflare answers curl with
      # "error code: <n>".
      headers=$(curl -s -D - --max-time 10 -H "X-Devopsy-Hold: no" --doh-url https://1.1.1.1/dns-query "https://$name/" 2>/dev/null | head -c 8192 || true)
      cferror=$(printf "%s\n" "$headers" | sed -n "s/^error code: \([0-9]*\).*/\1/p" | head -n 1)
      ;;
    *)
      info=$(curl -skv -o /dev/null --max-time 10 --resolve "$name:443:$IP" "https://$name/" 2>&1 || true)
      issuer=$(printf "%s\n" "$info" | sed -n "s/^\*  issuer: //p" | head -n 1 | sed "s/.*O=\([^;]*\);.*CN=\(.*\)/\1 \2/; s/^CN=//" | tr -d "\t")
      expire=$(printf "%s\n" "$info" | sed -n "s/^\*  expire date: //p" | head -n 1)
      expire=$(date -u -D "%b %e %H:%M:%S %Y GMT" -d "$expire" +%F 2>/dev/null || printf "%s" "$expire")
      curl -sv -o /dev/null --max-time 10 --resolve "$name:443:$IP" "https://$name/" 2>&1 | grep -q "^\*  *SSL certificate verify ok" && valid=true
      headers=$(curl -s -o /dev/null -D - --max-time 10 -H "X-Devopsy-Hold: no" --doh-url https://1.1.1.1/dns-query "https://$name/" 2>/dev/null || true)
      ;;
  esac
  status=$(printf "%s\n" "$headers" | sed -n "1s/^HTTP[^ ]* \([0-9]*\).*/\1/p")
  # A site that asks to be held, its app down: the hold answers at once
  # (X-Devopsy-Hold: no), under the 307 its errors middleware makes of
  # the 502, or a 503 with its router gone. Traefik answered, so it is no
  # tunnel or CDN error.
  held=false
  printf "%s\n" "$headers" | grep -qi "^x-devopsy-hold: *down" && held=true
  cf=false
  printf "%s\n" "$headers" | grep -qi "^cf-ray:" && cf=true
  # No HTTPS answer: Cloudflare still answers plain HTTP when its edge has
  # no certificate for the name (status stays 0).
  if [ -z "$status" ]; then
    curl -s -o /dev/null -D - --max-time 10 --doh-url https://1.1.1.1/dns-query "http://$name/" 2>/dev/null | grep -qi "^cf-ray:" && cf=true
  fi
  printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n" "$name" "$a" "$challenge" "$issuer" "$expire" "$valid" "${status:-0}" "$cf" "$cferror" "$held"
done
'

report_filter=$(cat "$dir/lib/domains/report.jq")
text_filter=$(cat "$dir/lib/domains/text.jq")

# reports: one JSON array, a report per host.
reports() {
  if [ -n "$project" ]; then
    hosts=$(project_hosts "$project")
    [ -n "$hosts" ] || die "$project's running containers have no Traefik Host() rules"
    # shellcheck disable=SC2086
    facts=$("$dir/lib/facts" $hosts)
  else
    facts=$("$dir/lib/facts" --all)
  fi
  # Only names that are host names reach the checks (and the shell): a
  # project's rule can say anything.
  names=$(printf '%s\n' "$facts" | jq -r '.hosts[] | .probe // .host | select(test("^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"))')
  tunneled=$(printf '%s\n' "$facts" | jq -r '[.hosts[] | select(.method == "tunnel") | .host | select(test("^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"))] | join(" ")')
  # shellcheck disable=SC2086
  out=$(quiet run --rm --no-deps -T -e IP="${PROXY_PUBLIC_IP:-}" -e FALLBACK_IP="$fallback_ip" -e TUNNELED="$tunneled" --entrypoint sh curl -c "$check_script" sh $names)
  ip=$(printf '%s\n' "$out" | head -n 1)
  [ -n "$ip" ] || die "could not tell this server's public IP: set PROXY_PUBLIC_IP in .env"
  checks=$(printf '%s\n' "$out" | tail -n +2 | jq -R 'select(. != "") | split("\t") | {name: .[0], a: (.[1] | fromjson? // null),
    challenge: (.[2] | fromjson? // null), issuer: .[3], expire: .[4], valid: (.[5] == "true"),
    status: (.[6] | tonumber? // 0), cf: (.[7] == "true"), cferror: (.[8] // ""), held: (.[9] == "true")}')
  # A 1033 can mean another thing when a connector here is up.
  connected=false
  connectors | awk -F '\t' '$3 == "healthy" { ok = 1 } END { exit !ok }' && connected=true
  printf '%s\n%s\n' "$facts" "$checks" | jq -s --arg ip "$ip" --argjson connected "$connected" "$report_filter"
}
show() { printf '%s\n' "$1" | jq -r "$text_filter"; }
pending() { printf '%s\n' "$1" | jq -r '.[] | select(.routed and (.valid | not) and (.tunnel | not)) | .host'; }

# The tunnel network's connectors (devopsy-template-cloudflared's
# containers): compose project, service and health, one per line. The
# template's healthcheck is `cloudflared tunnel ready`: healthy once
# connected to Cloudflare.
connectors() {
  # shellcheck disable=SC2016
  ids=$(docker network inspect -f '{{range $id, $c := .Containers}}{{$id}} {{end}}' tunnel 2>/dev/null) || return 0
  [ -n "$ids" ] || return 0
  # shellcheck disable=SC2086,SC2016
  docker inspect -f '{{index .Config.Labels "com.docker.compose.project"}}	{{index .Config.Labels "com.docker.compose.service"}}	{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' $ids |
    awk -F '\t' -v self="${COMPOSE_PROJECT_NAME:-}" '$1 != self' | sort
}
# show_connectors REPORTS: the connectors, and what to do when none is
# ready, when a host is tunneled or a connector runs.
show_connectors() {
  c=$(connectors)
  tunnels=$(printf '%s\n' "$1" | jq -r '[.[] | select(.tunnel)] | length')
  [ -n "$c" ] || [ "$tunnels" != 0 ] || return 0
  echo "Cloudflare tunnel connectors (the tunnel network)"
  if [ -z "$c" ]; then
    echo "  none running"
    echo "  next         release devopsy-template-cloudflared, an instance per Cloudflare account (@<server>:<account>/prod)"
  else
    printf '%s\n' "$c" | awk -F '\t' '{ printf "  %-40s %s\n", $1 " " $2, $3 }'
    if ! printf '%s\n' "$c" | awk -F '\t' '$3 == "healthy" { ok = 1 } END { exit !ok }'; then
      echo "  next         no connector is connected: check its token (--vars set PROXY_TUNNEL_TOKEN, then --reload), that outbound port 7844 (UDP or TCP) is open, and its logs"
    fi
  fi
  echo
}

r=$(reports)
ip=$(printf '%s\n' "$r" | jq -r 'first(.[].ip) // empty')
show "$r"
show_connectors "$r"
if [ "$retry" = 1 ]; then
  hosts=$(pending "$r")
  if [ -z "$hosts" ]; then
    echo "domains: nothing to retry." >&2
  else
    # shellcheck disable=SC2086
    "$dir/lib/retry" "$name" $hosts
    echo "domains: asked Traefik for the missing certificates. Checking again in 45 seconds..." >&2
    sleep 45
    r=$(reports)
    show "$r"
  fi
fi
# A retry request is only clutter once every certificate exists.
if [ -z "$(pending "$r")" ] && [ -f "$dir/mnt/dynamic/devopsy-retry-$name.yaml" ]; then
  "$dir/lib/retry" "$name" --done
  echo "domains: all certificates exist: removed the retry request." >&2
fi

# The same hosts from outside, from wherever devopsy-cli runs; tunneled ones
# have no port to probe.
probe=$(printf '%s\n' "$r" | jq -r '[.[] | select(.routed and .checked and (.tunnel | not)) | .name] | join(" ")')
[ -z "$probe" ] || printf 'To check from your machine:\n  devopsy --probe --ip %s %s\n' "$ip" "$probe"
