#!/bin/sh
## Description: Show or switch Let's Encrypt between staging and production
# Shows or switches the Let's Encrypt environment of every resolver:
#
#   devopsy letsencrypt              show the current one
#   devopsy letsencrypt production   real certificates
#   devopsy letsencrypt staging      test certificates
#
# Switching sets the CA server in .env, used by every resolver, then moves
# the old environment's accounts and certificates aside: Traefik would keep
# serving them until renewal otherwise. The acme-dns registrations
# (acme-dns-accounts.json) are kept, so existing CNAMEs stay valid. Traefik
# restarts, so sites are unavailable for a few seconds.
set -eu
. "$DEVOPSY_PROJECT_DIR/lib/common.sh"

production=https://acme-v02.api.letsencrypt.org/directory
staging=https://acme-staging-v02.api.letsencrypt.org/directory
key=TRAEFIK_CERTIFICATESRESOLVERS_LETSENCRYPT1_ACME_CASERVER

name_of() {
  case "$1" in
    "$production") echo production ;;
    "$staging" | '') echo staging ;;
    *) echo "custom ($1)" ;;
  esac
}

current=${TRAEFIK_CERTIFICATESRESOLVERS_LETSENCRYPT1_ACME_CASERVER:-}

case "${1:-}" in
  '')
    echo "Let's Encrypt: $(name_of "$current")"
    exit 0
    ;;
  production) target=$production ;;
  staging) target=$staging ;;
  *)
    echo "Usage: devopsy letsencrypt [production|staging]" >&2
    exit 1
    ;;
esac

if [ "$(name_of "$current")" = "$1" ]; then
  echo "Already on $1."
  exit 0
fi

echo "Switching Let's Encrypt from $(name_of "$current") to $1. Traefik restarts."
devopsy stop traefik

env_set "$key" "$target"

# Moved aside, not deleted, and never acme-dns-accounts.json. 10001's files:
# moved in a Traefik container.
suffix=$(name_of "$current" | cut -d' ' -f1).$(date +%Y%m%d%H%M%S)
# shellcheck disable=SC2016
in_traefik '
  for f in acme.json acme-acmedns.json acme-cloudflare.json; do
    if [ -s "/letsencrypt/$f" ]; then
      mv "/letsencrypt/$f" "/letsencrypt/$f.$1"
      echo "Moved $f to $f.$1"
    fi
  done' "$suffix"

devopsy up -d --wait
echo "Now on $1. Certificates are requested again as sites are routed."
