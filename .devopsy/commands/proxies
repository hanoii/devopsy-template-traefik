#!/bin/sh
## Description: Trusted proxies and CDNs, for real client IPs (add cloudflare, list, remove, refresh)
#
# Real client IPs behind HTTP proxies and CDNs, through the local proxies
# plugin in plugins-local/. Each proxy has a name, the header it passes the
# visitor in, and its ranges: CIDRs, or https URLs listing one per line.
#
#   devopsy proxies                           list the proxies
#   devopsy proxies add cloudflare            Cloudflare's published ranges and header
#   devopsy proxies add <name> <header> <range-or-url>...
#   devopsy proxies remove <name>
#   devopsy proxies refresh                   fetch URL ranges again
#
# Requests from a proxy's ranges get the visitor from its header; any other
# request loses those headers. Proxies using X-Forwarded-For or X-Real-Ip are
# also trusted for Traefik's forwarded headers. Adding the first proxy,
# removing the last one, or changing those trusted ranges restarts Traefik;
# anything else does not.
#
# The tunnel network's connectors (a Cloudflare Tunnel) are trusted on the
# tunnel entrypoint, built in: listed here, never added or removed (its
# middleware is static_env's, from the network's subnet).
#
# State lives in mnt/ (shared/mnt on a server), so releases keep it:
# mnt/proxies/proxies.conf, the proxies; mnt/proxies/forwarded-ips, the
# ranges trusted for forwarded headers; mnt/dynamic/proxies.yaml, the
# middleware. mnt/traefik.env, Traefik's static settings, comes from
# static_env (lib/common.sh), shared with deploy.
set -eu
. "$DEVOPSY_PROJECT_DIR/lib/common.sh"

conf=$dir/mnt/proxies/proxies.conf
forwarded_file=$dir/mnt/proxies/forwarded-ips
dynamic=$dir/mnt/dynamic/proxies.yaml
mkdir -p "$dir/mnt/proxies" "$dir/mnt/dynamic"

proxies() {
  [ -f "$conf" ] || return 0
  grep -v '^[[:space:]]*\(#\|$\)' "$conf" || true
}

# Prints the ranges of sources, one per line.
ranges() {
  for src in "$@"; do
    case $src in
      https://*)
        # Traefik's own wget: the host needs no curl.
        # shellcheck disable=SC2016
        list=$(in_traefik 'wget -qO- -T 15 "$1"' "$src") || die "could not fetch $src"
        for r in $list; do
          case $r in
            */* ) case $r in *[!0-9a-fA-F:./]*) die "unexpected range '$r' from $src" ;; esac; echo "$r" ;;
            *) die "unexpected range '$r' from $src" ;;
          esac
        done
        ;;
      */*)
        case $src in *[!0-9a-fA-F:./]*) die "not a range: $src" ;; esac
        echo "$src"
        ;;
      *) die "not a range or https URL: $src" ;;
    esac
  done
}

apply() {
  if [ -z "$(proxies)" ]; then
    rm -f "$forwarded_file"
    # Drops the proxies from the entrypoint, then their middleware.
    static_env
    echo "proxies: none, real client IPs are off"
    return
  fi

  yaml="# Written by 'devopsy proxies' from proxies.conf.
http:
  middlewares:
    proxies:
      plugin:
        proxies:
          proxies:
"
  forwarded=
  while read -r name header sources; do
    # shellcheck disable=SC2086
    r=$(ranges $sources) || exit 1
    [ -n "$r" ] || die "no ranges for $name"
    yaml="$yaml            - name: $name
              header: $header
              trustedIPs:
$(printf '%s\n' "$r" | sed 's/^/                - /')
"
    case $(echo "$header" | tr '[:upper:]' '[:lower:]') in
      x-forwarded-for | x-real-ip) forwarded="$forwarded $(echo "$r" | tr '\n' ' ')" ;;
    esac
  done <<EOT
$(proxies)
EOT

  # The middleware exists before the entrypoint references it.
  if write_if_changed "$dynamic" "$yaml"; then
    echo "proxies: wrote mnt/dynamic/proxies.yaml"
  fi
  if [ -n "$forwarded" ]; then
    write_if_changed "$forwarded_file" "$(printf '%s' "$forwarded" | tr -s ' \n' ',' | sed 's/^,//; s/,$//')" || true
  else
    rm -f "$forwarded_file"
  fi
  static_env
  proxies | while read -r name header _; do echo "proxies: $name ($header)"; done
}

valid_name() {
  case $1 in '' | *[!A-Za-z0-9_-]*) die "name must use letters, digits, '-' and '_': $1" ;; esac
  [ "$1" != tunnel ] || die "tunnel is built in: the tunnel network's connectors"
}

case "${1:-}" in
  '')
    subnet=$(tunnel_subnet)
    if [ -z "$(proxies)" ] && [ -z "$subnet" ]; then
      echo "No trusted proxies: real client IPs are off."
      exit 0
    fi
    proxies | while read -r name header sources; do printf '%s\t%s\t%s\n' "$name" "$header" "$sources"; done
    [ -z "$subnet" ] || printf 'tunnel\tCF-Connecting-IP\t%s (built in: the tunnel network, on its entrypoint)\n' "$subnet"
    ;;
  add)
    shift
    [ $# -ge 1 ] || die "usage: devopsy proxies add cloudflare | <name> <header> <range-or-url>..."
    if [ $# -eq 1 ]; then
      case $1 in
        cloudflare) set -- cloudflare CF-Connecting-IP https://www.cloudflare.com/ips-v4 https://www.cloudflare.com/ips-v6 ;;
        *) die "no preset named $1: give a header and ranges" ;;
      esac
    fi
    [ $# -ge 3 ] || die "usage: devopsy proxies add <name> <header> <range-or-url>..."
    name=$1
    header=$2
    valid_name "$name"
    case $header in '' | *[!A-Za-z0-9-]*) die "not a header name: $header" ;; esac
    shift 2
    ranges "$@" >/dev/null
    others=$(proxies | awk -v n="$name" '$1 != n')
    {
      [ -z "$others" ] || printf '%s\n' "$others"
      echo "$name $header $*"
    } >"$conf.tmp"
    mv "$conf.tmp" "$conf"
    apply
    ;;
  remove)
    [ $# -eq 2 ] || die "usage: devopsy proxies remove <name>"
    proxies | awk -v n="$2" '$1 == n { found = 1 } END { exit !found }' || die "no proxy named $2"
    proxies | awk -v n="$2" '$1 != n' >"$conf.tmp"
    mv "$conf.tmp" "$conf"
    apply
    ;;
  refresh)
    apply
    ;;
  *)
    die "usage: devopsy proxies [add <name> ... | remove <name> | refresh]"
    ;;
esac
