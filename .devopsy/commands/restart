#!/bin/sh
## Description: Pull newer images and recreate what changed
# Pull newer images and recreate whatever changed.
set -eu
. "$DEVOPSY_PROJECT_DIR/lib/common.sh"

devopsy pull
# Domains queued by `devopsy forget`.
forget_apply
static_env --no-restart
devopsy up -d --remove-orphans
# A tunnel network this `up` made again, perhaps on another subnet.
static_env
api_access
