#!/bin/sh
## Description: Set up this Traefik on a server, step by step (setup [<server>])
## Scope: local
# Asks for the settings, writes them to the server's shared/.env through
# `--vars`, releases, then walks through what comes after: acme-dns's DNS
# records, trusted proxies, production certificates and an alias. Every
# step is a devopsy command, printed before it runs: setup has no state of
# its own, and running it again shows the current values as defaults.
#
#   devopsy setup [<server>]
#
# <server> is an SSH destination, like any target's. The server needs
# Docker, the devopsy deploy user and devopsy: devopsy-server's setup.sh
# on Debian.
set -eu
. "$DEVOPSY_PROJECT_DIR/lib/common.sh"

[ -r /dev/tty ] || die "needs a terminal"
cd "$dir/.."

say() {
  printf '\n%s\n' "$*"
}

# ask <question> [<default>]: the answer, or the default when empty.
ask() {
  printf '%s%s: ' "$1" "${2:+ [$2]}" >/dev/tty
  read -r answer </dev/tty || answer=
  printf '%s\n' "${answer:-${2:-}}"
}

# confirm <question> <y|n>: true for yes.
confirm() {
  while :; do
    case $(ask "$1 (y/n)" "$2") in
      y | Y | yes) return 0 ;;
      n | N | no) return 1 ;;
    esac
  done
}

# secret <question>: a hidden answer.
secret() {
  printf '%s: ' "$1" >/dev/tty
  stty -echo </dev/tty
  read -r answer </dev/tty || answer=
  stty echo </dev/tty
  printf '\n' >/dev/tty
  printf '%s\n' "$answer"
}

# run <devopsy arguments>: printed, then run.
run() {
  printf '+ devopsy %s\n' "$*" >&2
  devopsy "$@"
}

server=${1:-}
[ -n "$server" ] || server=$(ask "Server (an SSH destination)" "${DEVOPSY_SERVER:-}")
[ -n "$server" ] || die "no server"
t=@$server:main

echo "Reading $server's settings..."
if ! names=$(devopsy "$t" --vars 2>/dev/null); then
  die "cannot reach $server as its deploy user. Set the server up first (devopsy-server's setup.sh), then: ssh $server docker info"
fi
# current <name>: its value on the server, or nothing.
current() {
  if printf '%s\n' "$names" | grep -qx "$1"; then
    devopsy "$t" --vars get "$1" 2>/dev/null || true
  fi
}

email_var=TRAEFIK_CERTIFICATESRESOLVERS_LETSENCRYPT1_ACME_EMAIL
set_names=
unset_names=
# setting <name> <value>: set in one --vars call at the end, through the
# environment, so values never travel as arguments.
setting() {
  eval "SETUP_VALUE_$1=\$2"
  set_names="$set_names $1"
}
# unsetting <name>: unset at the end, when the server has it.
unsetting() {
  if printf '%s\n' "$names" | grep -qx "$1"; then
    unset_names="$unset_names $1"
  fi
}

say "Let's Encrypt's account email, for expiry notices."
email=
while [ -z "$email" ]; do
  email=$(ask "Email" "$(current "$email_var")")
done
setting "$email_var" "$email"

profiles=$(current COMPOSE_PROFILES)
# Without acmedns; added back below when chosen.
profiles=$(printf '%s' "$profiles" | tr ',' '\n' | grep -vx acmedns | paste -sd, - || true)
domain=$(current DEVOPSY_PROXY_WILDCARD_DOMAIN)
resolver=$(current DEVOPSY_WILDCARD_CERTRESOLVER)
acmedns_domain=$(current DEVOPSY_ACMEDNS_DOMAIN)
case $domain in
  '') choice=1 ;;
  *.sslip.io) choice=3 ;;
  *) case $resolver in acmedns | cloudflare) choice=2 ;; *) choice=1 ;; esac ;;
esac

say "Wildcard URLs: every environment gets <project>-<environment>.<domain>, with
HTTPS, without DNS records of its own.

  1. A domain, one certificate per URL (HTTP-01). DNS: one *.<domain> record.
  2. A domain, one wildcard certificate (DNS-01, through acme-dns or
     Cloudflare): new URLs get HTTPS at once, and sites can get theirs before
     their DNS moves here.
  3. sslip.io, for tests: no DNS at all, the IP is in every URL.
  4. None: sites only answer on their own domains."
while :; do
  choice=$(ask "Choice" "$choice")
  case $choice in 1 | 2 | 3 | 4) break ;; esac
done

dns01=
case $choice in
  1 | 2)
    case $domain in *.sslip.io) domain= ;; esac
    domain=$(ask "Domain for this server, like vm1.example.com" "$domain")
    [ -n "$domain" ] || die "no domain"
    setting DEVOPSY_PROXY_WILDCARD_DOMAIN "$domain"
    ;;
  3)
    ip=$(ssh -G "$server" 2>/dev/null | awk '$1 == "hostname" { print $2 }')
    printf '%s\n' "$ip" | grep -Eqx '([0-9]{1,3}\.){3}[0-9]{1,3}' || ip=
    ip=$(ask "The server's public IPv4" "$ip")
    printf '%s\n' "$ip" | grep -Eqx '([0-9]{1,3}\.){3}[0-9]{1,3}' || die "not an IPv4 address: $ip"
    domain=$(printf '%s' "$ip" | tr . -).sslip.io
    setting DEVOPSY_PROXY_WILDCARD_DOMAIN "$domain"
    setting DEVOPSY_WILDCARD_CERTRESOLVER none
    ;;
  4)
    domain=
    unsetting DEVOPSY_PROXY_WILDCARD_DOMAIN
    unsetting DEVOPSY_WILDCARD_CERTRESOLVER
    ;;
esac

case $choice in
  1) setting DEVOPSY_WILDCARD_CERTRESOLVER none ;;
  2)
    say "DNS-01 through:

  1. acme-dns, on this server: no API token. Needs port 53 open (UDP and
     TCP), two records once, and one CNAME per domain.
  2. Cloudflare's API: a token for the zone that holds the challenges."
    case $resolver in cloudflare) d=2 ;; *) d=1 ;; esac
    while :; do
      d=$(ask "Choice" "$d")
      case $d in 1 | 2) break ;; esac
    done
    if [ "$d" = 1 ]; then
      dns01=acmedns
      acmedns_domain=$(ask "acme-dns's own subdomain, unique per server" "${acmedns_domain:-acme-$domain}")
      setting DEVOPSY_ACMEDNS_DOMAIN "$acmedns_domain"
      profiles=${profiles:+$profiles,}acmedns
    else
      dns01=cloudflare
      say "A Cloudflare token: Zone > Zone > Read and Zone > DNS > Edit, for the
zone of $domain only (README.md, \"Cloudflare API token\")."
      if printf '%s\n' "$names" | grep -qx DEVOPSY_CLOUDFLARE_DNS_API_TOKEN &&
        ! confirm "A token is already set. Replace it?" n; then
        :
      else
        token=$(secret "Token (hidden)")
        [ -n "$token" ] || die "no token"
        setting DEVOPSY_CLOUDFLARE_DNS_API_TOKEN "$token"
      fi
    fi
    setting DEVOPSY_WILDCARD_CERTRESOLVER "$dns01"
    ;;
esac

if [ -n "$profiles" ]; then
  setting COMPOSE_PROFILES "$profiles"
else
  unsetting COMPOSE_PROFILES
fi
[ "$dns01" = acmedns ] || unsetting DEVOPSY_ACMEDNS_DOMAIN

cloudflare_proxy=
say "Sites behind Cloudflare's proxy (orange cloud) need its ranges trusted, so
applications see visitors' IPs. Harmless when no site uses it."
if confirm "Trust Cloudflare's proxy?" y; then
  cloudflare_proxy=1
fi

# shellcheck disable=SC2086
[ -z "$unset_names" ] || run "$t" --vars unset $unset_names
# shellcheck disable=SC2086
(
  for n in $set_names; do
    eval "export $n=\"\$SETUP_VALUE_$n\""
  done
  run "$t" --vars set $set_names
)

say "Releasing Traefik to $server."
run "$t" --release

if [ -n "$cloudflare_proxy" ]; then
  run "$t" proxies add cloudflare
fi

case $choice in
  1 | 2)
    say "DNS: create an A record for *.$domain to this server's IP."
    if [ "$dns01" = acmedns ]; then
      say "acme-dns: open port 53, UDP and TCP, in your provider's firewall,
and create these records, once:"
      run "$t" acmedns
    fi
    ask "Press Enter once they exist" >/dev/null
    ;;
esac
if [ "$dns01" = acmedns ]; then
  say "The wildcard certificate registered with acme-dns on its first try and
waits for its CNAME, the last record listed here:"
  run "$t" acmedns
  ask "Press Enter once it exists" >/dev/null
  run "$t" domains --retry
elif [ -n "$domain" ]; then
  run "$t" domains
fi

say "Certificates are from Let's Encrypt's staging until you switch: browsers
do not trust them. Switch once the report above looks right; certificates
are requested again."
if confirm "Switch to production now?" n; then
  run "$t" letsencrypt production
else
  echo "Later: devopsy $t letsencrypt production"
fi

# vm1-traefik; from deploy@203.0.113.10, 203-0-113-10-traefik.
alias=$(printf '%s' "$server" | sed 's/^.*@//' | tr . -)-traefik
config=${DEVOPSY_HOME:-$HOME/.config/devopsy}/config.yaml
checkout=$(pwd)
line="$alias: {source: $checkout, to: \"$server:main\"}"
if [ -f "$config" ] && grep -Eq "^[[:space:]]+$alias:" "$config"; then
  say "Alias: @$alias already in $config."
else
  say "An alias runs this Traefik's commands from anywhere:
devopsy @$alias domains"
  if confirm "Add @$alias to $config?" y; then
    if [ ! -f "$config" ]; then
      mkdir -p "$(dirname "$config")"
      printf 'aliases:\n  %s\n' "$line" >"$config"
    elif grep -q '^aliases:[[:space:]]*$' "$config"; then
      # After `aliases:`, indented like the next line, else two spaces.
      tmp=$config.setup
      awk -v line="$line" '
        done != 1 && prev == 1 {
          indent = $0; sub(/[^ ].*/, "", indent)
          if (indent == "") indent = "  "
          print indent line; done = 1
        }
        { print; prev = ($0 ~ /^aliases:[ \t]*$/) }
        END { if (prev == 1 && done != 1) print "  " line }
      ' "$config" >"$tmp"
      cat "$tmp" >"$config"
      rm -f "$tmp"
    else
      echo "Add it under aliases: in $config:"
      printf '  %s\n' "$line"
      alias=
    fi
    [ -z "$alias" ] || echo "Added. devopsy @$alias domains"
  fi
fi

say "Done. Sites route through this Traefik by joining the \`traefik\` network;
devopsy-template-whoami is the smallest example."
