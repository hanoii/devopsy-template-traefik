#!/bin/sh
## Description: Set up this Traefik on a server, step by step
## Run: local
## Needs: target
# Asks for the settings, writes them to the server's shared/.env through
# `--vars`, releases, then walks through what comes after: acme-dns's DNS
# records, trusted proxies, production certificates and an alias. Every
# step is a devopsy command, printed before it runs: setup has no state of
# its own, and running it again shows the current values as defaults.
#
#   devopsy @<server>:prod setup     (or an alias: @vm1-traefik setup)
#
# <server> is an SSH destination, like any target's. The server needs
# Docker, the devopsy deploy user and devopsy: devopsy-server's setup.sh
# on Debian.
set -eu
. "$DEVOPSY_PROJECT_DIR/lib/common.sh"

[ -r /dev/tty ] || die "needs a terminal"
cd "$dir/.."

# Colors at a terminal, unless NO_COLOR.
bold='' dim='' cyan='' green='' yellow='' reset=''
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  esc=$(printf '\033')
  bold="${esc}[1m" dim="${esc}[2m" cyan="${esc}[36m" green="${esc}[32m" yellow="${esc}[33m" reset="${esc}[0m"
fi

# say <text>: a step, its first line bold.
say() {
  first=${1%%"
"*}
  printf '\n%s%s%s%s\n' "$bold" "$first" "$reset" "${1#"$first"}"
}

# note <text>: something to fix in an answer.
note() {
  printf '%s%s%s\n' "$yellow" "$*" "$reset"
}

# ask <question> [<default>]: the answer, or the default when empty.
ask() {
  printf '%s%s%s%s: ' "$cyan" "$1" "$reset" "${2:+ ${dim}[$2]$reset}" >/dev/tty
  read -r answer </dev/tty || answer=
  printf '%s\n' "${answer:-${2:-}}"
}

# confirm <question> <y|n>: true for yes.
confirm() {
  while :; do
    case $(ask "$1 (y/n)" "$2") in
      y | Y | yes) return 0 ;;
      n | N | no) return 1 ;;
    esac
  done
}

# secret <question>: a hidden answer.
secret() {
  printf '%s%s%s: ' "$cyan" "$1" "$reset" >/dev/tty
  stty -echo </dev/tty
  read -r answer </dev/tty || answer=
  stty echo </dev/tty
  printf '\n' >/dev/tty
  printf '%s\n' "$answer"
}

# acmedns_records: the records acme-dns needs, printed and kept in
# $records.
records=
acmedns_records() {
  printf '%s+ devopsy %s acmedns%s\n' "$dim" "$t" "$reset" >&2
  records=$(devopsy "$t" acmedns) || die "could not list acme-dns's records"
  printf '%s\n' "$records"
}

# run <devopsy arguments>: printed, then run.
run() {
  printf '%s+ devopsy %s%s\n' "$dim" "$*" "$reset" >&2
  devopsy "$@"
}

# The target as typed, used as is: vm1:prod, or an alias. Its server,
# for the alias, only when the address names one.
t=@$DEVOPSY_COMMAND_TARGET
case $DEVOPSY_COMMAND_TARGET in
  *:*) server=${DEVOPSY_COMMAND_TARGET%%:*} ;;
  *) server= ;;
esac

echo "Reading $t's settings..."
# What shared/.env holds, in one session, as --vars --show prints it
# (KEY='value', secrets included): what setup sets and unsets, also before
# the first release.
env=$(devopsy "$t" --vars --show 2>/dev/null) ||
  die "cannot reach $t. Set the server up first (devopsy-server's setup.sh), then check: ssh <server> docker info"
names=$(printf '%s\n' "$env" | sed -n 's/^\([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p')
# Released: deploy saves the Docker socket's group on its first run.
released=$(printf '%s\n' "$names" | grep -x PROXY_DOCKER_GID || true)
# current <name>: its value on the server, or nothing.
current() {
  printf '%s\n' "$env" | sed -n "s/^$1='\(.*\)'\$/\1/p" | head -n 1
}

email_var=PROXY_LE_ACME_EMAIL
set_names=
unset_names=
# setting <name> <value>: set in one --vars call at the end, through the
# environment, so values never travel as arguments.
setting() {
  eval "SETUP_VALUE_$1=\$2"
  set_names="$set_names $1"
}
# unsetting <name>: unset at the end, when the server has it.
unsetting() {
  if printf '%s\n' "$names" | grep -qx "$1"; then
    unset_names="$unset_names $1"
  fi
}

# The server's public IPv4, once: what DNS records point at.
# PROXY_PUBLIC_IP when set, else as 1.1.1.1 sees the server (right
# behind NAT too), else asked.
ip=
public_ip() {
  [ -z "$ip" ] || return 0
  ip=$(current PROXY_PUBLIC_IP)
  if [ -z "$ip" ]; then
    echo "Asking $t for its public IPv4..."
    ip=$(server_ip) || ip=
  fi
  if is_ipv4 "$ip"; then
    printf "The server's public IPv4: %s%s%s\n" "$green" "$ip" "$reset"
    return 0
  fi
  ip=$(ask "The server's public IPv4")
  is_ipv4 "$ip" || die "not an IPv4 address: $ip"
}
# server_ip: the IP 1.1.1.1 sees, from the server itself (curl comes with
# devopsy-server's setup). Through SSH, not a project command: the server
# may have no release yet. --ssh-config names the SSH destination, alias
# or not.
server_ip() {
  # shellcheck disable=SC2046
  set -- $(devopsy "$t" --ssh-config 2>/dev/null | awk '
    $1 == "Host" { h = $2 } $1 == "User" { u = $2 "@" } $1 == "Port" { p = "-p " $2 }
    END { if (h != "") print p, u h }')
  [ $# -gt 0 ] || return 1
  ssh -o BatchMode=yes -o ClearAllForwardings=yes "$@" \
    curl -s --max-time 10 https://1.1.1.1/cdn-cgi/trace </dev/null |
    sed -n 's/^ip=\([0-9.]*\)$/\1/p'
}
is_ipv4() {
  printf '%s\n' "$1" | grep -Eqx '([0-9]{1,3}\.){3}[0-9]{1,3}'
}

say "Let's Encrypt's account email, for expiry notices."
email=
while [ -z "$email" ]; do
  email=$(ask "Email" "$(current "$email_var")")
done
setting "$email_var" "$email"

ca_var=PROXY_LE_ACME_CASERVER
production_ca=https://acme-v02.api.letsencrypt.org/directory
case $(current "$ca_var") in *staging*) d=n ;; *) d=y ;; esac
say "Certificates come from Let's Encrypt: production, trusted by browsers, or
staging, test certificates browsers warn about, for trying things out
without production's rate limits."
if confirm "Production? (n: staging)" "$d"; then
  letsencrypt=production
else
  letsencrypt=staging
fi
# A server not released yet starts on the right one; a released one
# switches after the release (letsencrypt moves the old certificates aside).
if [ -z "$released" ]; then
  if [ "$letsencrypt" = staging ]; then
    unsetting "$ca_var"
  else
    setting "$ca_var" "$production_ca"
  fi
  letsencrypt=
fi

profiles=$(current COMPOSE_PROFILES)
# Without acmedns; added back below when chosen.
profiles=$(printf '%s' "$profiles" | tr ',' '\n' | grep -vx acmedns | paste -sd, - || true)
domain=$(current PROXY_BASE_DOMAIN)
resolver=$(current PROXY_WILDCARD_CERTRESOLVER)
acmedns_domain=$(current PROXY_ACMEDNS_DOMAIN)
case $domain in
  '') choice=1 ;;
  *.sslip.io) choice=3 ;;
  *) case $resolver in le-dns01-selfhosted | le-dns01-cloudflare) choice=2 ;; *) choice=1 ;; esac ;;
esac
[ "$(current PROXY_TUNNEL_ONLY)" != true ] || choice=5

say "Wildcard URLs: every environment gets <project>-<environment>.<domain>, with
HTTPS, without DNS records of its own.

  1. A domain, one certificate per URL (HTTP-01). DNS: one *.<domain> record.
  2. A domain, one wildcard certificate (DNS-01, through acme-dns or
     Cloudflare): new URLs get HTTPS at once, and sites can get theirs before
     their DNS moves here.
  3. sslip.io, for tests: no DNS at all, the IP is in every URL.
  4. None: sites only answer on their own domains.
  5. Through a Cloudflare Tunnel: no port open but SSH, every site through
     Cloudflare's edge (its TLS, WAF and Access). Wildcard URLs and sites'
     own domains alike, in the tunnel's Cloudflare account."
while :; do
  choice=$(ask "Choice" "$choice")
  case $choice in 1 | 2 | 3 | 4 | 5) break ;; esac
done

dns01=
case $choice in
  1 | 2)
    case $domain in *.sslip.io) domain= ;; esac
    domain=$(ask "Domain for this server, like vm1.example.com" "$domain")
    [ -n "$domain" ] || die "no domain"
    setting PROXY_BASE_DOMAIN "$domain"
    ;;
  3)
    public_ip
    domain=$(printf '%s' "$ip" | tr . -).sslip.io
    setting PROXY_BASE_DOMAIN "$domain"
    setting PROXY_WILDCARD_CERTRESOLVER none
    ;;
  4)
    domain=
    unsetting PROXY_BASE_DOMAIN
    unsetting PROXY_WILDCARD_CERTRESOLVER
    ;;
  5)
    case $domain in *.sslip.io) domain= ;; esac
    say "The base domain, in a zone of the tunnel's Cloudflare account. At the
zone's apex (example.com, URLs like whoami-prod.example.com), Cloudflare's
free edge certificate covers every URL; one level deeper
(vm1.example.com) needs Advanced Certificate Manager. Empty: no wildcard
URLs, sites only on their own domains."
    domain=$(ask "Domain" "$domain")
    if [ -n "$domain" ]; then
      setting PROXY_BASE_DOMAIN "$domain"
    else
      unsetting PROXY_BASE_DOMAIN
    fi
    setting PROXY_WILDCARD_CERTRESOLVER none
    ;;
esac

# Tunnel only: Traefik's ports bound to the server's loopback, so nothing
# answers on its public address even before the provider's firewall.
# Leaving it, back to every address; a loopback bind otherwise is the
# operator's own.
# loopback <name> <default port>: the setting for the choice.
loopback() {
  v=$(current "$1")
  if [ "$choice" = 5 ]; then
    case $v in
      '') setting "$1" "127.0.0.1:$2" ;;
      *:*) ;;
      *) setting "$1" "127.0.0.1:$v" ;;
    esac
  elif [ "$(current PROXY_TUNNEL_ONLY)" = true ]; then
    case $v in
      "127.0.0.1:$2") unsetting "$1" ;;
      127.0.0.1:*) setting "$1" "${v#127.0.0.1:}" ;;
    esac
  fi
}
loopback PROXY_HTTP_PORT 80
loopback PROXY_HTTPS_PORT 443
if [ "$choice" = 5 ]; then
  setting PROXY_TUNNEL_ONLY true
else
  unsetting PROXY_TUNNEL_ONLY
fi

case $choice in
  1) setting PROXY_WILDCARD_CERTRESOLVER none ;;
  2)
    say "DNS-01 through:

  1. acme-dns, on this server: no API token. Needs port 53 open (UDP and
     TCP), two records and the wildcard's CNAME, once.
  2. Cloudflare's API: a token for the zone that holds the challenges."
    case $resolver in le-dns01-cloudflare) d=2 ;; *) d=1 ;; esac
    while :; do
      d=$(ask "Choice" "$d")
      case $d in 1 | 2) break ;; esac
    done
    if [ "$d" = 1 ]; then
      dns01=le-dns01-selfhosted
      acmedns_domain=$(ask "acme-dns's own subdomain, unique per server" "${acmedns_domain:-acme-$domain}")
      setting PROXY_ACMEDNS_DOMAIN "$acmedns_domain"
      profiles=${profiles:+$profiles,}acmedns
    else
      dns01=le-dns01-cloudflare
      say "A Cloudflare token: Zone > Zone > Read and Zone > DNS > Edit, for the
zone of $domain only (README.md, \"Cloudflare API token\")."
      if [ -n "$(current PROXY_CLOUDFLARE_DNS_API_TOKEN)" ] &&
        ! confirm "A token is already set. Replace it?" n; then
        :
      else
        token=$(secret "Token (hidden)")
        [ -n "$token" ] || die "no token"
        setting PROXY_CLOUDFLARE_DNS_API_TOKEN "$token"
      fi
    fi
    setting PROXY_WILDCARD_CERTRESOLVER "$dns01"
    ;;
esac

if [ -n "$profiles" ]; then
  setting COMPOSE_PROFILES "$profiles"
else
  unsetting COMPOSE_PROFILES
fi
[ "$dns01" = le-dns01-selfhosted ] || unsetting PROXY_ACMEDNS_DOMAIN

# Sites' own domains: the resolver every router naming none uses
# (PROXY_CERTRESOLVER). Only a DNS-01 one set up above is a choice;
# otherwise HTTP-01.
if [ -n "$dns01" ]; then
  # Unset is HTTP-01 too.
  case $(current PROXY_CERTRESOLVER) in '' | le-http01) d=1 ;; *) d=2 ;; esac
  say "Certificates for sites' own domains, by default:

  1. HTTP-01 (le-http01): once a domain points at this server. Nothing to
     create.
  2. DNS-01 ($dns01): before DNS moves here, and behind Cloudflare's proxy.
     $(if [ "$dns01" = le-dns01-selfhosted ]; then echo "One CNAME per domain, created once."; else echo "Domains under the token's zones, or delegating their challenge to one."; fi)

A site can still name its own (the site templates' PROXY_CERTRESOLVER)."
  while :; do
    d=$(ask "Choice" "$d")
    case $d in 1 | 2) break ;; esac
  done
  # Set either way, so running setup again offers the answer given.
  if [ "$d" = 2 ]; then
    setting PROXY_CERTRESOLVER "$dns01"
  else
    setting PROXY_CERTRESOLVER le-http01
  fi
else
  unsetting PROXY_CERTRESOLVER
fi

# Through a tunnel, visitors' IPs come from the connectors, built in.
cloudflare_proxy=
if [ "$choice" != 5 ]; then
  say "Sites behind Cloudflare's proxy (orange cloud) need its ranges trusted, so
applications see visitors' IPs. Harmless when no site uses it."
  if confirm "Trust Cloudflare's proxy?" y; then
    cloudflare_proxy=1
  fi
fi

# shellcheck disable=SC2086
[ -z "$unset_names" ] || run "$t" --vars unset $unset_names
# shellcheck disable=SC2086
(
  for n in $set_names; do
    eval "export $n=\"\$SETUP_VALUE_$n\""
  done
  run "$t" --vars set $set_names
)

say "Releasing Traefik to $t."
run "$t" --release
[ -z "$letsencrypt" ] || run "$t" letsencrypt "$letsencrypt"

if [ -n "$cloudflare_proxy" ]; then
  run "$t" proxies add cloudflare
fi

case $choice in
  1 | 2)
    public_ip
    say "DNS: create this record where $domain's zone is hosted:

  $green*.$domain.  A  $ip$reset

At Cloudflare, keep it DNS only (grey cloud). Its free edge certificate
only covers one level below the zone: proxied, *.$domain fails HTTPS
unless $domain is the zone itself. Sites can still use the proxy for
their own domains."
    if [ "$dns01" = le-dns01-selfhosted ]; then
      say "acme-dns: open port 53, UDP and TCP, in your provider's firewall,
and create these records, once:"
      acmedns_records
    fi
    ask "Press Enter once they exist" >/dev/null
    ;;
esac
if [ "$choice" = 5 ]; then
  route=${domain:+"*.$domain"}
  say "Cloudflare, in the account holding ${domain:-the zones of your sites}:

  1. Networking > Tunnels: create a tunnel (cloudflared), named after
     this server, and copy its token (the value after --token in the
     command shown). The dashboard waits for a connector: release
     devopsy-template-cloudflared now, from its checkout, as an instance
     per Cloudflare account (own: any name for this one):

     ${green}devopsy @${server:-<server>}:own/prod --vars set PROXY_TUNNEL_TOKEN$reset
     ${green}devopsy @${server:-<server>}:own/prod --release$reset

  2. Its published application routes:${route:+ $green$route$reset to}
     ${green}http://traefik.tunnel:8081$reset (type HTTP)${route:+, and later the domains
     of sites}${route:-: the domains of sites}.
  3. DNS: ${route:-each name} CNAME $green<tunnel id>.cfargotunnel.com$reset, proxied
     (orange cloud). The dashboard creates it with the route: check
     it is there.
  4. SSL/TLS: Always Use HTTPS on (requests reach Traefik as plain HTTP,
     past its redirect). The encryption mode does not apply to the
     tunnel; Full (strict) for the zone's records that reach a server
     directly.
  5. A firewall at your provider letting in SSH only, and out port 7844
     (UDP and TCP).

Then check with ${green}devopsy $t domains$reset: hosts through the tunnel and its
connectors."
fi
if [ "$dns01" = le-dns01-selfhosted ]; then
  # Traefik registers the wildcard with acme-dns on its first try, usually
  # before the listing above: its CNAME was there unless it was not yet.
  case $records in
    *_acme-challenge.*) ;;
    *)
      say "The wildcard certificate has registered with acme-dns since, and
waits for its CNAME, the one marked the public wildcard:"
      acmedns_records
      ask "Press Enter once it exists" >/dev/null
      ;;
  esac
  run "$t" domains --retry
elif [ -n "$domain" ] && [ "$choice" != 5 ]; then
  run "$t" domains
fi

# An alias, named by the operator; none when called through one.
config=${DEVOPSY_HOME:-$HOME/.config/devopsy}/config.yaml
checkout=$(pwd)
alias=
if [ -n "$server" ]; then
  say "An alias runs this Traefik's commands from anywhere, like
devopsy @vm1-traefik domains. Added to $config."
  while :; do
    alias=$(ask "Alias name (Enter to skip)")
    case $alias in
      '') break ;;
      *[!A-Za-z0-9._-]*) note "Letters, digits, '.', '_' and '-' only." ;;
      *)
        if [ -f "$config" ] && grep -Eq "^[[:space:]]+$alias:" "$config"; then
          note "@$alias is already in $config."
        else
          break
        fi
        ;;
    esac
  done
fi
line="$alias: {source: $checkout, to: \"$DEVOPSY_COMMAND_TARGET\"}"
if [ -n "$alias" ]; then
  if [ ! -f "$config" ]; then
    mkdir -p "$(dirname "$config")"
    printf 'aliases:\n  %s\n' "$line" >"$config"
  elif grep -q '^aliases:[[:space:]]*$' "$config"; then
    # After `aliases:`, indented like the next line, else two spaces.
    tmp=$config.setup
    awk -v line="$line" '
      done != 1 && prev == 1 {
        indent = $0; sub(/[^ ].*/, "", indent)
        if (indent == "") indent = "  "
        print indent line; done = 1
      }
      { print; prev = ($0 ~ /^aliases:[ \t]*$/) }
      END { if (prev == 1 && done != 1) print "  " line }
    ' "$config" >"$tmp"
    cat "$tmp" >"$config"
    rm -f "$tmp"
  else
    echo "Add it under aliases: in $config:"
    printf '  %s\n' "$line"
    alias=
  fi
  [ -z "$alias" ] || echo "${green}Added.$reset devopsy @$alias domains"
fi

say "${green}Done.$reset$bold Sites route through this Traefik by joining the \`traefik\` network;
devopsy-template-whoami is the smallest example."
