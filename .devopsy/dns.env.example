# Optional DNS-01 certificates through Cloudflare. Copy to dns.env (not
# committed) and set the token. Traefik then has a second resolver,
# `cloudflare`, besides the default HTTP-01 `letsencrypt1`.
#
# DNS-01 works with the Cloudflare proxy on, before DNS points at this server,
# and for wildcard certificates. Two ways to use it, both automatic:
#
# - Domains in a zone the token can edit: nothing else to do.
# - Any domain, on Cloudflare or not: create once, at its DNS host, a CNAME
#   from _acme-challenge.<domain> to a name in a dedicated challenge zone the
#   token can edit, like <domain>.example-acme.com. Traefik follows it and
#   writes the TXT record there. See README.md.
#
# Token: a Cloudflare custom token with Zone > Zone > Read and Zone > DNS >
# Edit, limited to the zones that receive the TXT records. See README.md.
CF_DNS_API_TOKEN=

TRAEFIK_CERTIFICATESRESOLVERS_CLOUDFLARE=true
TRAEFIK_CERTIFICATESRESOLVERS_CLOUDFLARE_ACME_EMAIL=you@example.com
# Staging by default. Use https://acme-v02.api.letsencrypt.org/directory for
# real certificates.
TRAEFIK_CERTIFICATESRESOLVERS_CLOUDFLARE_ACME_CASERVER=https://acme-staging-v02.api.letsencrypt.org/directory
TRAEFIK_CERTIFICATESRESOLVERS_CLOUDFLARE_ACME_STORAGE=/letsencrypt/acme-cloudflare.json
TRAEFIK_CERTIFICATESRESOLVERS_CLOUDFLARE_ACME_DNSCHALLENGE_PROVIDER=cloudflare
# Check propagation against public resolvers, not the host's.
TRAEFIK_CERTIFICATESRESOLVERS_CLOUDFLARE_ACME_DNSCHALLENGE_RESOLVERS=1.1.1.1:53,1.0.0.1:53
